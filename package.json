{
  "name": "comissoes",
  "productName": "Comissões",
  "version": "1.1.1",
  "description": "Painel pessoal de comissões e clientes (GFX Roblox)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "author": "sak",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.sak.comissoes",
    "productName": "Comissões",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "conta.js",
      "nuvem.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Comissoes-${version}-instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Comissões",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallDisplayName": "Comissões"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kauanlacerda",
        "repo": "comissoes",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kauanlacerda/comissoes.git"
  }
}
